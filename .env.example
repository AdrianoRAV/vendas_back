# ==== Credenciais do Admin Inicial (bootstrap) ====
# Estas variáveis são usadas APENAS na primeira execução,
# se ainda não existir nenhum admin no banco.
# Depois de criar, troque a senha no primeiro login.
ADMIN_EMAIL=admin@seudominio.com
ADMIN_SENHA=TroqueEstaSenha123!

# ==== Segurança ====
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=64a7c866e94fb092e79ed5e66a0eabc5d46613af29c5f16a51c649f2772f8d55

# ==== Ambiente ====
# 'dev' cria loja de exemplo + dados fake. 'prod' não cria nada.
AMBIENTE=dev

# ==== Banco ====
# SQLite (padrão para dev):
DATABASE_URL=sqlite:///app.db

# PostgreSQL (produção) — descomente e ajuste:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco